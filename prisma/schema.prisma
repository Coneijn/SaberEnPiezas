generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CustomerType {
  teacher
  parent
  institution
  individual
}

enum IdentityType {
  whatsapp
  phone
  email
}

enum ReservationStatus {
  held
  converted
  released
  reconciled_late
  reconciled_oversold
}

enum OrderStatus {
  pending
  paid
  preparing
  shipped
  delivered
  cancelled
}

enum TicketChannel {
  whatsapp
  web
  instagram
}

enum TicketStatus {
  open
  pending_customer
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum WarrantyStatus {
  queued
  in_production
  ready_to_ship
  dispatched
}

model Customer {
  id             String             @id @default(uuid()) @db.Uuid
  fullName       String?            @map("full_name") @db.VarChar(150)
  email          String?            @unique @db.VarChar(150)
  institution    String?            @db.VarChar(200)
  interestArea   String?            @map("interest_area") @db.VarChar(150)
  customerType   CustomerType       @default(individual) @map("customer_type")
  notes          String?            @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  identities     CustomerIdentity[]
  orders         Order[]
  events         CustomerEvent[]
  tickets        SupportTicket[]
  surveys        CxSurvey[]
  reservations   StockReservation[]

  @@map("customers")
}

model CustomerIdentity {
  id            String       @id @default(uuid()) @db.Uuid
  customerId    String       @map("customer_id") @db.Uuid
  identityType  IdentityType @map("identity_type")
  identityValue String       @map("identity_value") @db.VarChar(100)
  isPrimary     Boolean      @default(false) @map("is_primary")
  verified      Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at")

  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([identityType, identityValue], name: "uq_identity")
  @@map("customer_identities")
}

model Product {
  id           String            @id @default(uuid()) @db.Uuid
  sku          String            @unique @db.VarChar(50)
  title        String            @db.VarChar(255)
  slug         String            @unique @db.VarChar(255)
  description  String?           @db.Text
  basePrice    Decimal           @map("base_price") @db.Decimal(10, 2)
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")

  inventory    ProductInventory?
  orderItems   OrderItem[]
  reservations StockReservation[]
  warranties   WarrantyClaim[]

  @@map("products")
}

model ProductInventory {
  productId     String   @id @map("product_id") @db.Uuid
  stockOnHand   Int      @default(0) @map("stock_on_hand")
  stockReserved Int      @default(0) @map("stock_reserved")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_inventory")
}

model StockReservation {
  id                String            @id @default(uuid()) @db.Uuid
  sessionId         String            @map("session_id") @db.VarChar(100)
  customerId        String?           @map("customer_id") @db.Uuid
  orderId           String?           @map("order_id") @db.Uuid
  orderItemId       String?           @map("order_item_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  quantity          Int
  externalReference String?           @map("external_reference") @db.VarChar(150)
  preferenceId      String?           @map("preference_id") @db.VarChar(150)
  status            ReservationStatus @default(held)
  releaseReason     String?           @map("release_reason") @db.VarChar(50)
  expiresAt         DateTime          @map("expires_at")
  convertedAt       DateTime?         @map("converted_at")
  releasedAt        DateTime?         @map("released_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order             Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem         OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product           Product           @relation(fields: [productId], references: [id])

  @@index([externalReference], name: "idx_reservations_external_ref")
  @@index([orderId], name: "idx_reservations_order_id")
  @@index([status, expiresAt], name: "idx_reservations_cleanup")
  @@map("stock_reservations")
}

model Order {
  id              String               @id @default(uuid()) @db.Uuid
  orderNumber     Int                  @unique @default(autoincrement()) @map("order_number")
  customerId      String               @map("customer_id") @db.Uuid
  status          OrderStatus          @default(pending)
  subtotal        Decimal              @db.Decimal(10, 2)
  shippingCost    Decimal              @default(0.00) @map("shipping_cost") @db.Decimal(10, 2)
  total           Decimal              @db.Decimal(10, 2)
  shippingAddress Json                 @map("shipping_address")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  customer        Customer             @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  reservations    StockReservation[]
  transactions    PaymentTransaction[]
  shipments       OrderShipment[]
  tickets         SupportTicket[]
  surveys         CxSurvey[]
  warranties      WarrantyClaim[]

  @@map("orders")
}

model OrderItem {
  id           String             @id @default(uuid()) @db.Uuid
  orderId      String             @map("order_id") @db.Uuid
  productId    String             @map("product_id") @db.Uuid
  quantity     Int
  unitPrice    Decimal            @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal            @map("total_price") @db.Decimal(10, 2)

  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id])
  reservations StockReservation[]

  @@map("order_items")
}

model PaymentTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  gateway           String   @default("mercadopago") @db.VarChar(30)
  externalPaymentId String?  @unique @map("external_payment_id") @db.VarChar(100)
  status            String   @db.VarChar(50)
  paymentMethod     String?  @map("payment_method") @db.VarChar(50)
  rawResponse       Json?    @map("raw_response")
  createdAt         DateTime @default(now()) @map("created_at")

  order             Order    @relation(fields: [orderId], references: [id])

  @@map("payment_transactions")
}

model OrderShipment {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  carrier        String    @db.VarChar(100)
  trackingNumber String    @map("tracking_number") @db.VarChar(150)
  trackingUrl    String?   @map("tracking_url") @db.Text
  shippedAt      DateTime  @default(now()) @map("shipped_at")
  deliveredAt    DateTime? @map("delivered_at")

  order          Order     @relation(fields: [orderId], references: [id])

  @@map("order_shipments")
}

model CustomerEvent {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  sessionId  String   @map("session_id") @db.VarChar(100)
  eventType  String   @map("event_type") @db.VarChar(50)
  eventData  Json?    @map("event_data")
  createdAt  DateTime @default(now()) @map("created_at")

  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("customer_events")
}

model SupportTicket {
  id           String         @id @default(uuid()) @db.Uuid
  ticketNumber Int            @unique @default(autoincrement()) @map("ticket_number")
  customerId   String         @map("customer_id") @db.Uuid
  orderId      String?        @map("order_id") @db.Uuid
  channel      TicketChannel  @default(whatsapp)
  status       TicketStatus   @default(open)
  priority     TicketPriority @default(medium)
  subject      String         @db.VarChar(200)
  createdAt    DateTime       @default(now()) @map("created_at")
  resolvedAt   DateTime?      @map("resolved_at")

  customer     Customer       @relation(fields: [customerId], references: [id])
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notes        TicketNote[]
  warranties   WarrantyClaim[]

  @@map("support_tickets")
}

model TicketNote {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  authorName String        @map("author_name") @db.VarChar(100)
  isInternal Boolean       @default(true) @map("is_internal")
  content    String        @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_notes")
}

model WarrantyClaim {
  id              String         @id @default(uuid()) @db.Uuid
  ticketId        String         @map("ticket_id") @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  productId       String         @map("product_id") @db.Uuid
  partDescription String         @map("part_description") @db.Text
  status          WarrantyStatus @default(queued)
  createdAt       DateTime       @default(now()) @map("created_at")
  dispatchedAt    DateTime?      @map("dispatched_at")

  ticket          SupportTicket  @relation(fields: [ticketId], references: [id])
  order           Order          @relation(fields: [orderId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])

  @@map("warranty_claims")
}

model CxSurvey {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  csatScore  Int?     @map("csat_score")
  npsScore   Int?     @map("nps_score")
  feedback   String?  @map("feedback_text") @db.Text
  answeredAt DateTime @default(now()) @map("answered_at")

  order      Order    @relation(fields: [orderId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])

  @@map("cx_surveys")
}
